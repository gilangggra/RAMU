# ==============================================================================
# RAMU (Creative Opportunity Engine) — Environment Variables Example
# ==============================================================================
# Salin file ini menjadi .env.local untuk environment lokal:
# cp .env.example .env.local
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ramu_db?schema=public"

# Authentication (NextAuth / Auth.js)
AUTH_SECRET="generate-a-strong-32-byte-secret-here-for-session-encryption"
NEXTAUTH_URL="http://localhost:3000"

# Supabase (Opsional - jika menggunakan hosted Supabase)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Provider (Google Gemini API — Digunakan HANYA untuk modul narasi/penjelasan)
# Jika dikosongkan, sistem otomatis fallback ke MockAIExplanationProvider
GEMINI_API_KEY=""

# Application Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="RAMU"
NEXT_PUBLIC_APP_TAGLINE="Creative Opportunity Engine"
